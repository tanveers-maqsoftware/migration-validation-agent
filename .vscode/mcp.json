{
  "servers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--browser=msedge",
        "--viewport-size=1920x1080",
        "--output-dir=validation-screenshots",
        "--storage-state=migration-validation-mcp/auth-state.json"
      ]
    },
    "migration-validation": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "migration-validation-mcp",
        "migration-validation-mcp"
      ]
    }
  }
}
