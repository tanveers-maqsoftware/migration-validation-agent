{
  "servers": {
    "playwright": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "python",
        "migration-validation-mcp/scripts/run_playwright_mcp.py"
      ]
    },
    "migration-validation": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "migration-validation-mcp",
        "migration-validation-mcp"
      ]
    }
  }
}
