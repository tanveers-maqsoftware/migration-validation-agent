{
  "servers": {
    "playwright": {
      "type": "stdio",
      "command": "node",
      "args": [
        "scripts/run-playwright-mcp.mjs"
      ]
    },
    "migration-validation": {
      "type": "stdio",
      "command": "uv",
      "args": [
