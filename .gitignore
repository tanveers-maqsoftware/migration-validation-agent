# Secrets — never commit credentials or captured login sessions
.env
auth-state.json

# Personal, machine-local tool settings (permissions, etc.) — not shared config
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Run outputs — regenerated on every validation run
validation-screenshots/
validation-reports/
harness-log.json
playwright-report/
test-results/

# Non-screenshot files (console logs, page snapshots) swept out of
# validation-screenshots/ by ScreenshotDirCleaner — see migration_validation/services/screenshot_dir.py
playwright-debug/

# OS / editor noise
.DS_Store
Thumbs.db
