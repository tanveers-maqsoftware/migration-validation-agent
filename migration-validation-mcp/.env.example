# Copy to .env and adjust. All keys are optional — defaults live in
# src/config/settings.py. Never commit the real .env (it is gitignored).

# Comparison bands: variance <= pass -> PASS, <= warning -> WARNING, above -> FAIL
NUMERIC_PASS_PCT=0.0
NUMERIC_WARNING_PCT=0.5
PERCENTAGE_TOLERANCE_POINTS=1.0

# Output locations
REPORTS_DIR=validation-reports
AUTH_STATE_PATH=auth-state.json
HISTORY_PATH=harness-log.json
